# Copy to .env (local) or set these two in Render > Environment. Both are PUBLIC values:
# what each person may read or write is decided by the rules in supabase/01-schema.sql.
# Supabase > Project Settings > API Keys: the PUBLISHABLE key (sb_publishable_...), never the secret one.
# The build refuses a secret key, a key from another project and the Lumina project (tools/check-supabase-env.mjs).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
